# MongoDB DAM local configuration.
#
# Copy this file to .env, or run ./scripts/generate-secrets.sh to create .env
# with the four local secrets generated for you. Entry-point scripts load .env
# automatically. A variable supplied by the calling shell takes precedence.

# Target-account safety guard. This must exactly match:
#   kubectl config current-context
EXPECTED_KUBE_CONTEXT=

# Event assignment
CUSTOMER_ID=customer-demo
TENANT_ID=tenant-demo
SOURCE_ID=mongodb-demo
REGIONAL_CELL_ID=cell-ap-south-1
CLUSTER_NAME=customer-demo-eks

# Kubernetes / Helm
NAMESPACE=mongodb-dam
RELEASE=mongodb-dam
SECRET_NAME=mongodb-dam-secrets
VALUES_FILE=deploy/examples/s3-demo-values.yaml
DEPLOY_TIMEOUT=10m
MONGODB_IMAGE_TAG=8.0.29-noble
DEMO_MODE=true

# Local image build and the image repositories used by Helm. When REGISTRY is
# set, deploy.sh derives each repository from it unless the matching explicit
# *_IMAGE_REPOSITORY value below is set.
REGISTRY=
TAG=v0.1.0-dam-demo
PUSH_IMAGES=true
BUILD_DEMO=true
BUILD_MOCK=false
OBSERVER_IMAGE_REPOSITORY=
OUTPOST_IMAGE_REPOSITORY=
DEMO_API_IMAGE_REPOSITORY=
DEMO_RECEIVER_IMAGE_REPOSITORY=

# Outpost destination: s3 for the cross-account demo, or http for the bundled
# local receiver compatibility path.
OUTPOST_DESTINATION=s3

# S3 destination
OUTPOST_S3_BUCKET=
OUTPOST_S3_PREFIX=mongodb-dam/events
AWS_REGION=ap-south-1
OUTPOST_S3_ENDPOINT_URL=
OUTPOST_S3_FORCE_PATH_STYLE=false
OUTPOST_S3_CREDENTIALS_SECRET=

# Disposable-demo static credentials copied into the Outpost Kubernetes
# Secret. Keep these OUTPOST_ scoped so local AWS CLI calls can use AWS_PROFILE
# (admin or demo user) independently. Leave blank when using EKS Pod Identity,
# IRSA, or an existing OUTPOST_S3_CREDENTIALS_SECRET.
OUTPOST_AWS_ACCESS_KEY_ID=
OUTPOST_AWS_SECRET_ACCESS_KEY=
OUTPOST_AWS_SESSION_TOKEN=

# Local administrator AWS CLI identity used for provisioning and reading S3.
# Use either a configured profile or static demoware credentials. Environment
# credentials take precedence when both forms are filled.
AWS_PROFILE=dam-admin
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Simulated customer user. Use either its profile or its scoped static keys.
# The direct-user scripts isolate these from the administrator identity above.
DIRECT_USER_AWS_PROFILE=dam-user
DIRECT_USER_AWS_ACCESS_KEY_ID=
DIRECT_USER_AWS_SECRET_ACCESS_KEY=
DIRECT_USER_AWS_SESSION_TOKEN=

# HTTP destination (only required when OUTPOST_DESTINATION=http)
ENDPOINT=http://mock-endpoint:8088/v1/ingest/mongodb-dam
ENDPOINT_CA_FILE=
ENDPOINT_CA_SECRET_NAME=mongodb-dam-destination-ca

# Generated by scripts/generate-secrets.sh. Replace these values manually only
# when creating .env by copying this example.
OBSERVER_INTERNAL_TOKEN=generate-me
BEARER_TOKEN=generate-me
PRINCIPAL_HASH_SALT=generate-me
MONGODB_ROOT_USERNAME=dam-admin
MONGODB_ROOT_PASSWORD=generate-me

# Direct IAM user -> Secrets Manager -> MongoDB SCRAM demo
DEMO_IAM_PRINCIPAL_ARN=
DEMO_AWS_SECRET_ID=mongodb-dam/demo/direct-user
DEMO_DATABASE=dam_demo
DIRECT_USER_MAPPING_SECRET=mongodb-dam-demo-direct-user
DIRECT_USER_MAPPING_KEY=identity-mapping.json
USE_EXISTING_MONGODB_FORWARD=false
MONGODB_LOCAL_PORT=27018
MONGODB_CLIENT_IMAGE=mongo:8.0.29-noble
MONGOSH_BIN=mongosh
DIRECT_USER_MONGOSH_MODE=auto
DIRECT_USER_API_LOCAL_PORT=18082
DIRECT_USER_RUN_MARKER_FILE=
DIRECT_USER_NOT_BEFORE_EPOCH=

# Demo/viewer ports and optional viewer filters
DEMO_API_LOCAL_PORT=18080
DEMO_RECEIVER_LOCAL_PORT=18088
DEMO_OUTPOST_LOCAL_PORT=18090
DEMO_OBSERVER_LOCAL_PORT=18091
DEMO_RECEIVER_SERVICE=mock-endpoint
SHOW_S3_MAX_OBJECTS=250
MAX_OBJECTS=100
EVENT_TYPE=mongodb_activity
DATABASE=dam_demo
